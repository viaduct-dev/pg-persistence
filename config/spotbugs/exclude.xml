<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Kotlin's inlined map/filter operators allocate ArrayLists through Collection-typed locals.
         Restrict this to the generated destination$iv locals, so explicit Kotlin casts are checked. -->
    <Match>
        <Bug pattern="BC_BAD_CAST_TO_ABSTRACT_COLLECTION"/>
        <Class name="~dev\.viaduct\.persistence\..*"/>
        <Source name="~.*[.]kt"/>
        <Local name="~destination([$]iv)+"/>
    </Match>

    <!-- Suspend calls return Object in JVM bytecode, including the coroutine suspension marker. -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
        <Class name="~dev[.]viaduct[.]persistence[.].*"/>
        <Method returns="java.lang.Object"/>
        <Or>
            <Annotation name="kotlin.coroutines.jvm.internal.DebugMetadata"/>
            <And>
                <Class name="~dev[.]viaduct[.]persistence[.]runtime[.](connection[.]ConnectionFetcher|db[.](BlockingDbTransactions|DbBatchFetcher|DbClient|DbFetcher|DbTransaction|PgGraphqlClient|PgGraphqlMutationClient|PgGraphqlTransactionIntegrationTest)|graphql[.]PgGraphqlTransport)"/>
                <Method name="~fetch.*|insertRaw.*|updateRaw.*|deleteRaw.*|commit.*|execute.*|select.*|insert|update|delete"/>
            </And>
            <And>
                <Class name="~dev[.]viaduct[.]persistence[.]runtime[.]db[.](DbBatchFetcher|TransactionNestingKt)"/>
                <Method name="~recoverRow|withoutNestedTransaction"/>
            </And>
        </Or>
    </Match>

    <!-- Continuation resumption passes placeholder null arguments to generated suspend entry points. -->
    <Match>
        <Bug pattern="NP_NONNULL_PARAM_VIOLATION"/>
        <Annotation name="kotlin.coroutines.jvm.internal.DebugMetadata"/>
        <Method name="invokeSuspend"/>
    </Match>

    <!-- Kotlin's generated continuations inherit Serializable; captured values are not serialized. -->
    <Match>
        <Bug pattern="SE_BAD_FIELD,SE_BAD_FIELD_STORE"/>
        <Annotation name="kotlin.coroutines.jvm.internal.DebugMetadata"/>
    </Match>

    <!-- Kotlin reassigns continuation spill fields when a value survives another suspension. -->
    <Match>
        <Bug pattern="SA_FIELD_SELF_ASSIGNMENT"/>
        <Annotation name="kotlin.coroutines.jvm.internal.DebugMetadata"/>
        <Method name="invokeSuspend"/>
        <Field name="~L[$][0-9]+"/>
    </Match>

    <!-- Gradle/Hibernate handles are shared by design. Policy and collection-mapping records
         share read-only inputs. Only these existing fields are excluded, not new class fields. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class
            name="~dev\.viaduct\.persistence\.(gradle\.(EffectiveModelRegistrar|HibernateDiffTaskRegistrar|HibernateSnapshotTaskRegistrar|KotlinPersistenceProjectConfigurator|PersistenceBuildLayout|PersistenceGenerationRegistrar)|hibernate\.HibernateMetadataHandle|liquibase\.LiquibaseDatabaseSession|model\.(PersistenceModelPolicy|CollectionMappingContext))"
        />
        <Field name="~project|mainSourceSet|classLoader|database|deniedTypeNames|semanticNotNullTypeNames|semanticNotNullFieldCoordinates|unidirectionalTargetForeignKeyFields|inverseFieldOverrides|uniqueKeysByType|sourceCollections|inverseToOneFields|inverseCollections|sourceEdgeMappings|inverseEdgeMappings"/>
    </Match>

    <!-- Resolver descriptors/clients and per-call validation inputs are shared by design. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class
            name="~dev\.viaduct\.persistence\.runtime\.(connection\.EdgeShape|db\.(ActiveImmediateTransaction|DbBatchFetcher|DbEntityMutations|DbFetcher|DbTransactionEntity|DbTransactionScope|SemanticValidationRequest))"
        />
        <Field name="~node|cursor|queryPlanner|client|transaction|execution|owner|scope|data|errors"/>
    </Match>

    <!-- load() returns the shared, immutable mapping for a classloader. -->
    <Match>
        <Bug pattern="MS_EXPOSE_REP"/>
        <Class name="dev.viaduct.persistence.runtime.reflection.AbstractTypeMappings$Companion"/>
        <Method name="load"/>
        <Field name="cache"/>
    </Match>
    <!-- Application-owned Hibernate handles are shared intentionally, not copied into the bridge. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Or>
            <And>
                <Class name="~dev[.]viaduct[.]persistence[.]orm[.](HibernateClient|grt[.]DelegateHibernateClient)"/>
                <Field name="factory"/>
            </And>
            <And>
                <Class name="dev.viaduct.persistence.orm.HibernateObject"/>
                <Field name="session"/>
            </And>
        </Or>
    </Match>
    <!-- The continuation returns the callback's result, not its captured factory. -->
    <Match>
        <Bug pattern="MS_EXPOSE_REP"/>
        <Class name="~dev[.]viaduct[.]persistence[.]orm[.](HibernateClient|grt[.]DelegateHibernateClient)[$]transaction[$]2"/>
        <Method name="invokeSuspend"/>
        <Field name="factory"/>
    </Match>
    <!-- This integration fixture deliberately lends its factory and database to test cases. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="dev.viaduct.persistence.postgresql.HibernateRuntimeFixture"/>
        <Field name="~factory|database"/>
    </Match>
    <!-- The delegate experiment lends its factory to tests. Hibernate associations/collections
         must retain managed identity and PersistentBag wrappers for native dirty checking.
         These mapped fields stay inside session-confined delegates; GRT outputs are detached. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Or>
            <And>
                <Class name="dev.viaduct.persistence.postgresql.delegate.DelegateFixture"/>
                <Field name="factory"/>
            </And>
            <And>
                <Class name="dev.viaduct.persistence.postgresql.delegate.DelegatePerson"/>
                <Field name="~nativeManager|nativeReports"/>
            </And>
            <And>
                <Class name="dev.viaduct.persistence.postgresql.delegate.DelegateGroup"/>
                <Field name="~nativeMembers|nativeUsers|nativeFeaturedUsers"/>
            </And>
            <And>
                <Class name="dev.viaduct.persistence.postgresql.delegate.DelegateMembership"/>
                <Field name="~nativePerson|nativeGroup"/>
            </And>
        </Or>
    </Match>
    <!-- Generated-delegate tests share their client, typed access adapter, and SessionFactory. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="dev.viaduct.persistence.postgresql.delegate.GeneratedDelegateFixture"/>
        <Field name="~factory|client|access"/>
    </Match>
    <!-- This generated JUnit continuation returns Unit or the suspension marker, not its state.
         SpotBugs incorrectly classifies invokeSuspend as a public static representation accessor. -->
    <Match>
        <Bug pattern="MS_EXPOSE_REP"/>
        <Class name="dev.viaduct.persistence.postgresql.delegate.GeneratedDelegateSchemaCoverageTest$native arrays JSON UUID scalars and isX booleans round trip through public GRT accessors$1"/>
        <Method name="invokeSuspend"/>
        <Annotation name="kotlin.coroutines.jvm.internal.DebugMetadata"/>
    </Match>
</FindBugsFilter>
