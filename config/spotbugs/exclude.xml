<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Kotlin's inlined map/filter operators allocate ArrayLists through Collection-typed locals.
         Restrict this to the generated destination$iv locals, so explicit Kotlin casts are checked. -->
    <Match>
        <Bug pattern="BC_BAD_CAST_TO_ABSTRACT_COLLECTION"/>
        <Class name="~dev\.viaduct\.persistence\..*"/>
        <Source name="~.*[.]kt"/>
        <Local name="~destination([$]iv)+"/>
    </Match>

    <!-- Suspend calls return Object in JVM bytecode, including the coroutine suspension marker. -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
        <Class name="~dev[.]viaduct[.]persistence[.].*"/>
        <Method returns="java.lang.Object"/>
        <Or>
            <Annotation name="kotlin.coroutines.jvm.internal.DebugMetadata"/>
            <And>
                <Class name="~dev[.]viaduct[.]persistence[.]runtime[.](connection[.]ConnectionFetcher|db[.](DbBatchFetcher|DbClient|DbFetcher|DbTransaction|PgGraphqlClient|PgGraphqlMutationClient|PgGraphqlTransactionIntegrationTest)|graphql[.]PgGraphqlTransport)"/>
                <Method name="~fetch.*|insertRaw.*|updateRaw.*|deleteRaw.*|commit.*|execute.*|select.*|insert|update|delete"/>
            </And>
        </Or>
    </Match>

    <!-- Continuation resumption passes placeholder null arguments to generated suspend entry points. -->
    <Match>
        <Bug pattern="NP_NONNULL_PARAM_VIOLATION"/>
        <Annotation name="kotlin.coroutines.jvm.internal.DebugMetadata"/>
        <Method name="invokeSuspend"/>
    </Match>

    <!-- Kotlin's generated continuations inherit Serializable; captured values are not serialized. -->
    <Match>
        <Bug pattern="SE_BAD_FIELD,SE_BAD_FIELD_STORE"/>
        <Annotation name="kotlin.coroutines.jvm.internal.DebugMetadata"/>
    </Match>

    <!-- Gradle/Hibernate handles are shared by design. Policy and collection-mapping records
         share read-only inputs. Only these existing fields are excluded, not new class fields. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class
            name="~dev\.viaduct\.persistence\.(gradle\.(EffectiveModelRegistrar|HibernateDiffTaskRegistrar|HibernateSnapshotTaskRegistrar|KotlinPersistenceProjectConfigurator|PersistenceBuildLayout|PersistenceGenerationRegistrar)|hibernate\.HibernateMetadataHandle|liquibase\.LiquibaseDatabaseSession|model\.(PersistenceModelPolicy|CollectionMappingContext))"
        />
        <Field name="~project|mainSourceSet|classLoader|database|deniedTypeNames|semanticNotNullTypeNames|semanticNotNullFieldCoordinates|unidirectionalTargetForeignKeyFields|inverseFieldOverrides|sourceCollections|inverseToOneFields|inverseCollections|sourceEdgeMappings|inverseEdgeMappings"/>
    </Match>

    <!-- Resolver descriptors/clients and per-call validation inputs are shared by design. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class
            name="~dev\.viaduct\.persistence\.runtime\.(connection\.EdgeShape|db\.(DbBatchFetcher|DbEntityMutations|DbFetcher|DbTransactionEntity|DbTransactionScope|SemanticValidationRequest))"
        />
        <Field name="~node|cursor|queryPlanner|client|transaction|data|errors"/>
    </Match>

    <!-- load() returns the shared, immutable mapping for a classloader. -->
    <Match>
        <Bug pattern="MS_EXPOSE_REP"/>
        <Class name="dev.viaduct.persistence.runtime.reflection.AbstractTypeMappings$Companion"/>
        <Method name="load"/>
        <Field name="cache"/>
    </Match>
</FindBugsFilter>
