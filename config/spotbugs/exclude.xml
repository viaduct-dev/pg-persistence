<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Kotlin's inlined map/filter operators allocate ArrayLists through Collection-typed locals.
         Restrict this to the generated destination$iv locals, so explicit Kotlin casts are checked. -->
    <Match>
        <Bug pattern="BC_BAD_CAST_TO_ABSTRACT_COLLECTION"/>
        <Class name="~dev\.viaduct\.persistence\..*"/>
        <Source name="~.*[.]kt"/>
        <Local name="~destination([$]iv)+"/>
    </Match>

    <!-- Suspend calls return Object in JVM bytecode, including the coroutine suspension marker. -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
        <Class name="~dev[.]viaduct[.]persistence[.].*"/>
        <Method returns="java.lang.Object"/>
        <Or>
            <Annotation name="kotlin.coroutines.jvm.internal.DebugMetadata"/>
            <And>
                <Class name="~dev[.]viaduct[.]persistence[.]runtime[.](connection[.]ConnectionFetcher|db[.](BlockingDbTransactions|DbBatchFetcher|DbClient|DbFetcher|DbTransaction|PgGraphqlClient|PgGraphqlMutationClient|PgGraphqlTransactionIntegrationTest)|graphql[.]PgGraphqlTransport)"/>
                <Method name="~fetch.*|insertRaw.*|updateRaw.*|deleteRaw.*|commit.*|execute.*|select.*|insert|update|delete"/>
            </And>
            <And>
                <Class name="~dev[.]viaduct[.]persistence[.]runtime[.]db[.](DbBatchFetcher|TransactionNestingKt)"/>
                <Method name="~recoverRow|withoutNestedTransaction"/>
            </And>
        </Or>
    </Match>

    <!-- Continuation resumption passes placeholder null arguments to generated suspend entry points. -->
    <Match>
        <Bug pattern="NP_NONNULL_PARAM_VIOLATION"/>
        <Annotation name="kotlin.coroutines.jvm.internal.DebugMetadata"/>
        <Method name="invokeSuspend"/>
    </Match>

    <!-- Kotlin's generated continuations inherit Serializable; captured values are not serialized. -->
    <Match>
        <Bug pattern="SE_BAD_FIELD,SE_BAD_FIELD_STORE"/>
        <Annotation name="kotlin.coroutines.jvm.internal.DebugMetadata"/>
    </Match>

    <!-- Kotlin reassigns continuation spill fields when a value survives another suspension. -->
    <Match>
        <Bug pattern="SA_FIELD_SELF_ASSIGNMENT"/>
        <Annotation name="kotlin.coroutines.jvm.internal.DebugMetadata"/>
        <Method name="invokeSuspend"/>
        <Field name="~L[$][0-9]+"/>
    </Match>

    <!-- Gradle/Hibernate handles are shared by design. Policy and collection-mapping records
         share read-only inputs. Only the explicitly listed shared fields are excluded. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class
            name="~dev\.viaduct\.persistence\.(gradle\.(EffectiveModelRegistrar|HibernateDiffTaskRegistrar|HibernateSnapshotTaskRegistrar|KotlinPersistenceProjectConfigurator|PersistenceBuildLayout|PersistenceGenerationRegistrar)|hibernate\.HibernateMetadataHandle|liquibase\.LiquibaseDatabaseSession|model\.(PersistenceModelPolicy|CollectionMappingContext))"
        />
        <Field name="~project|mainSourceSet|classLoader|database|deniedTypeNames|semanticNotNullTypeNames|semanticNotNullFieldCoordinates|unidirectionalTargetForeignKeyFields|inverseFieldOverrides|uniqueKeysByType|indexesByType|sourceCollections|inverseToOneFields|inverseCollections|sourceEdgeMappings|inverseEdgeMappings"/>
    </Match>

    <!-- Resolver descriptors/clients and per-call validation inputs are shared by design. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class
            name="~dev\.viaduct\.persistence\.runtime\.(connection\.EdgeShape|db\.(ActiveImmediateTransaction|DbBatchFetcher|DbEntityMutations|DbFetcher|DbTransactionEntity|DbTransactionScope|SemanticValidationRequest))"
        />
        <Field name="~node|cursor|queryPlanner|client|transaction|execution|owner|scope|data|errors"/>
    </Match>

    <!-- load() returns the shared, immutable mapping for a classloader. -->
    <Match>
        <Bug pattern="MS_EXPOSE_REP"/>
        <Class name="dev.viaduct.persistence.runtime.reflection.AbstractTypeMappings$Companion"/>
        <Method name="load"/>
        <Field name="cache"/>
    </Match>
    <!-- The local integration fixture shares its caller-owned connection for index observations. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="dev.viaduct.persistence.postgresql.ApprovalRequestFixture"/>
        <Field name="database"/>
    </Match>
    <!-- Kotlin 2.3 clears dead continuation spill slots by passing null to
         nullOutSpilledVariable(Object). javap confirms these loads only clear slots. -->
    <Match>
        <Bug pattern="NP_LOAD_OF_KNOWN_NULL_VALUE"/>
        <Or>
            <And>
                <Class name="dev.viaduct.persistence.runtime.db.DbTransaction"/>
                <Method name="prepare"/>
            </And>
            <And>
                <Class name="dev.viaduct.persistence.runtime.db.RetryableTransactionExecutor$execute$result$1"/>
                <Method name="invokeSuspend"/>
            </And>
        </Or>
    </Match>

    <!-- Selection fragments share Viaduct's read-only variable map for one request. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="dev.viaduct.persistence.runtime.select.PersistenceSelectionFragment"/>
        <Field name="variables"/>
    </Match>
</FindBugsFilter>
