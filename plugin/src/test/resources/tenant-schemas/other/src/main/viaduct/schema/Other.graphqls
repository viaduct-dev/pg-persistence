type Purchase implements Node @resolver(isSelective: true) {
  id: ID!
  label: String!
  buyer: Group!
}
type PurchaseEdge @edge { cursor: String!, node: Purchase! }
type PurchaseConnection @connection { edges: [PurchaseEdge!]!, pageInfo: PageInfo! }
extend type Query {
  lookupPurchases(label: String!, first: Int, after: String, last: Int, before: String): PurchaseConnection! @resolver(isSelective: true)
}
