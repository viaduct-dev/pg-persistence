-- The record table is generated by Hibernate. Apply its migration before this overlay.
DO $role$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'persistence_executor') THEN
        CREATE ROLE persistence_executor NOLOGIN;
    END IF;
END;
$role$;
REVOKE ALL ON ~table~ FROM PUBLIC;
GRANT USAGE ON SCHEMA ~schema~ TO persistence_executor;
GRANT SELECT, INSERT ON ~table~ TO persistence_executor;

CREATE OR REPLACE FUNCTION public."pgPersistenceExecuteTransaction"("operationId" text, request jsonb)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY INVOKER
AS $function$
DECLARE
    scope text := nullif(current_setting('request.headers', true), '')::jsonb ->> 'x-pg-persistence-scope';
    record_key text;
    saved_request jsonb;
    saved_response jsonb;
    result jsonb;
BEGIN
    IF NOT pg_has_role(current_user, 'persistence_executor', 'MEMBER') OR scope IS NULL OR length(scope) = 0 THEN
        RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'Trusted transaction scope is required';
    END IF;
    IF current_setting('pg_persistence.executing', true) = 'true' THEN
        RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'Recursive transaction execution is not supported';
    END IF;
    IF current_setting('transaction_isolation') != 'read committed' THEN
        RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'Retryable transactions require READ COMMITTED';
    END IF;
    IF "operationId" IS NULL OR length("operationId") = 0 OR octet_length("operationId") > 256
       OR octet_length(scope) > 256 OR request IS NULL OR octet_length(request::text) > 1048576
       OR (request -> 'protocolVersion') IS DISTINCT FROM '1'::jsonb
       OR jsonb_typeof(request -> 'document') IS DISTINCT FROM 'string'
       OR jsonb_typeof(request -> 'variables') IS DISTINCT FROM 'object'
       OR (request ->> 'operationName') IS DISTINCT FROM 'DbTransaction' THEN
        RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'Invalid prepared transaction';
    END IF;
    record_key := jsonb_build_array(current_user, scope, "operationId")::text;
    IF NOT pg_try_advisory_xact_lock(hashtextextended(record_key, 0)) THEN
        RETURN jsonb_build_object('status', 'busy');
    END IF;
    -- Separate statement after acquiring the lock: see a preceding attempt's commit.
    SELECT r.~request~, r.~response~ INTO saved_request, saved_response FROM ~table~ r WHERE r.~id~ = record_key;
    IF FOUND THEN
        IF saved_request IS DISTINCT FROM request THEN
            RETURN jsonb_build_object('status', 'mismatch');
        END IF;
        RETURN jsonb_build_object('status', 'committed', 'response', saved_response);
    END IF;
    BEGIN
        PERFORM set_config('pg_persistence.executing', 'true', true);
        result := graphql.resolve(request ->> 'document', request -> 'variables', request ->> 'operationName');
        IF jsonb_typeof(result -> 'data') IS DISTINCT FROM 'object'
           OR COALESCE(result -> 'errors', '[]'::jsonb) != '[]'::jsonb THEN
            RAISE EXCEPTION USING ERRCODE = 'P0022', MESSAGE = 'Inner GraphQL failure';
        END IF;
        INSERT INTO ~table~ (~id~, ~request~, ~response~, ~completedAt~)
            VALUES (record_key, request, result, clock_timestamp());
        PERFORM set_config('pg_persistence.executing', 'false', true);
        RETURN jsonb_build_object('status', 'committed', 'response', result);
    EXCEPTION
        WHEN SQLSTATE 'P0022' THEN
            RETURN jsonb_build_object('status', 'rolledBack', 'errors',
                COALESCE(result -> 'errors', jsonb_build_array(jsonb_build_object('message', 'Invalid pg_graphql response'))));
        WHEN OTHERS THEN
            RETURN jsonb_build_object('status', 'rolledBack', 'code', SQLSTATE,
                'errors', jsonb_build_array(jsonb_build_object('message', 'Database transaction failed',
                    'extensions', jsonb_build_object('sqlState', SQLSTATE))));
    END;
END;
$function$;
REVOKE ALL ON FUNCTION public."pgPersistenceExecuteTransaction"(text, jsonb) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public."pgPersistenceExecuteTransaction"(text, jsonb) TO persistence_executor;
COMMENT ON FUNCTION public."pgPersistenceExecuteTransaction"(text, jsonb)
    IS '@graphql({"name":"pgPersistenceExecuteTransaction"})';

CREATE OR REPLACE FUNCTION public."pgPersistenceLookupTransaction"("operationId" text)
RETURNS jsonb LANGUAGE plpgsql STABLE SECURITY INVOKER
AS $function$
DECLARE
    scope text := nullif(current_setting('request.headers', true), '')::jsonb ->> 'x-pg-persistence-scope';
    record_key text;
    saved_request jsonb;
    saved_response jsonb;
BEGIN
    IF NOT pg_has_role(current_user, 'persistence_executor', 'MEMBER') OR scope IS NULL OR length(scope) = 0 THEN
        RAISE EXCEPTION USING ERRCODE = '42501', MESSAGE = 'Trusted transaction scope is required';
    END IF;
    IF "operationId" IS NULL OR length("operationId") = 0 OR octet_length("operationId") > 256 OR octet_length(scope) > 256 THEN
        RAISE EXCEPTION USING ERRCODE = '22023', MESSAGE = 'Invalid transaction identity';
    END IF;
    record_key := jsonb_build_array(current_user, scope, "operationId")::text;
    SELECT r.~request~, r.~response~ INTO saved_request, saved_response FROM ~table~ r WHERE r.~id~ = record_key;
    IF NOT FOUND THEN
        RETURN jsonb_build_object('status', 'notFound');
    END IF;
    RETURN jsonb_build_object('status', 'committed', 'request', saved_request, 'response', saved_response);
END;
$function$;
REVOKE ALL ON FUNCTION public."pgPersistenceLookupTransaction"(text) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public."pgPersistenceLookupTransaction"(text) TO persistence_executor;
COMMENT ON FUNCTION public."pgPersistenceLookupTransaction"(text)
    IS '@graphql({"name":"pgPersistenceLookupTransaction"})';
