delimiters "$", "$"

main(mdl) ::= <<
<?xml version="1.0" encoding="UTF-8"?>
<hibernate-mapping xmlns="http://www.hibernate.org/xsd/orm/hbm" schema="public">
$mdl.entities:{entity |$renderEntity(entity)$}$
</hibernate-mapping>
>>

renderEntity(entity) ::= <<
  <class entity-name="$entity.entityName; format="xml-attribute"$" table="$entity.tableName; format="xml-attribute"$"$if(entity.schemaName)$ schema="$entity.schemaName; format="xml-attribute"$"$endif$ lazy="false">
$entity.attributes:{attribute |$renderAttribute(attribute)$}$
  </class>
>>

renderAttribute(attribute) ::= <<
$if(attribute.basic)$$renderBasic(attribute.basic)$$endif$$if(attribute.toOne)$$renderToOne(attribute.toOne)$$endif$$if(attribute.toMany)$$renderToMany(attribute.toMany)$$endif$
>>

renderBasic(basic) ::= <<
    <$if(basic.primaryKey)$id$else$property$endif$ name="$basic.name; format="xml-attribute"$" type="$basic.hibernateType; format="xml-attribute"$"$if(!basic.primaryKey)$ not-null="$if(basic.nullable)$false$else$true$endif$"$endif$$if(!basic.insertable)$ insert="false"$endif$$if(!basic.updatable)$ update="false"$endif$>
      <column name="$basic.columnName; format="xml-attribute"$" not-null="$if(basic.nullable)$false$else$true$endif$"$if(basic.columnDefinition)$ sql-type="$basic.columnDefinition; format="xml-attribute"$"$endif$ />
$if(basic.primaryKey)$
      <generator class="assigned" />
$endif$
    </$if(basic.primaryKey)$id$else$property$endif$>
>>

renderToOne(toOne) ::= <<
    <many-to-one name="$toOne.name; format="xml-attribute"$" entity-name="$toOne.targetEntityName; format="xml-attribute"$" not-null="$if(toOne.nullable)$false$else$true$endif$" lazy="proxy" foreign-key="$toOne.foreignKeyName; format="xml-attribute"$">
      <column name="$toOne.columnName; format="xml-attribute"$" not-null="$if(toOne.nullable)$false$else$true$endif$" sql-type="uuid" />
    </many-to-one>
>>

renderToMany(toMany) ::= <<
    <bag name="$toMany.name; format="xml-attribute"$" lazy="true"$if(toMany.inverse)$ inverse="true"$endif$$if(toMany.joinTableName)$ table="$toMany.joinTableName; format="xml-attribute"$"$endif$$if(toMany.joinSchemaName)$ schema="$toMany.joinSchemaName; format="xml-attribute"$"$endif$>
      <key column="$toMany.keyColumnName; format="xml-attribute"$" not-null="$if(toMany.keyNullable)$false$else$true$endif$" />
$if(toMany.targetColumnName)$
      <many-to-many entity-name="$toMany.targetEntityName; format="xml-attribute"$" foreign-key="$toMany.targetForeignKeyName; format="xml-attribute"$" column="$toMany.targetColumnName; format="xml-attribute"$" />
$else$
      <one-to-many entity-name="$toMany.targetEntityName; format="xml-attribute"$" />
$endif$
    </bag>
>>
